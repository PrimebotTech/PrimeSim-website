---
interface Props { headers: string[]; rows: (string | number)[][]; label: string; highlight?: number; }
const { headers, rows, label, highlight = -1 } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={label}>
<table><caption>{label}</caption><thead><tr>{headers.map(h => <th scope="col">{h}</th>)}</tr></thead>
<tbody>{rows.map((row, index) => <tr class:list={{ highlighted: index === highlight }}>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table>
</div>
